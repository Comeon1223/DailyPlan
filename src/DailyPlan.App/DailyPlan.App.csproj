<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>DailyPlan.App</RootNamespace>
    <AssemblyName>DailyPlan</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Product>每天计划</Product>
    <AssemblyTitle>每天计划</AssemblyTitle>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Speech" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DailyPlan.Client\DailyPlan.Client.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(NativeCoreDll)')">
    <None Include="$(NativeCoreDll)" CopyToOutputDirectory="PreserveNewest" Link="DailyPlanCore.dll" />
  </ItemGroup>

</Project>

<Window x:Class="DailyPlan.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:client="clr-namespace:DailyPlan.Client;assembly=DailyPlan.Client"
        Title="每天计划"
        Width="1060"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="26,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="13" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="日"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="每天计划" Style="{StaticResource PageTitleText}" />
                        <TextBlock Text="把每一天，安排得刚刚好"
                                   Margin="0,2,0,0"
                                   FontSize="10.5"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button x:Name="PreviousDayButton"
                            Style="{StaticResource NavButton}"
                            Content="‹"
                            ToolTip="前一天"
                            Click="PreviousDayButton_Click" />

                    <Grid Margin="2,0">
                        <Button x:Name="DateButton"
                                Style="{StaticResource DateButtonStyle}"
                                MinWidth="176"
                                ToolTip="选择日期"
                                Click="DateButton_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DateTitle}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <Border Margin="8,0,0,0"
                                                Padding="6,2"
                                                CornerRadius="6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasRelativeDay}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding RelativeDayText}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding WeekdayText}"
                                               Margin="0,1,0,0"
                                               HorizontalAlignment="Left"
                                               FontSize="10.5"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                                <TextBlock Text="⌄"
                                           Margin="9,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </Button>

                        <Popup x:Name="CalendarPopup"
                               PlacementTarget="{Binding ElementName=DateButton}"
                               Placement="Bottom"
                               VerticalOffset="8"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Margin="10"
                                    Background="White"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="6">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.18" Color="#101322" />
                                </Border.Effect>
                                <Calendar x:Name="PlanCalendar"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          SelectedDatesChanged="PlanCalendar_SelectedDatesChanged" />
                            </Border>
                        </Popup>
                    </Grid>

                    <Button x:Name="NextDayButton"
                            Style="{StaticResource NavButton}"
                            Content="›"
                            ToolTip="后一天"
                            Click="NextDayButton_Click" />

                    <Button x:Name="TodayButton"
                            Style="{StaticResource GhostButton}"
                            Content="今天"
                            Margin="5,0,0,0"
                            Click="TodayButton_Click" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ToggleButton x:Name="VoiceToggle"
                                  Style="{StaticResource VoiceToggleStyle}"
                                  ToolTip="任务开始和结束时用语音提醒"
                                  Checked="VoiceToggle_Changed"
                                  Unchecked="VoiceToggle_Changed">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7"
                                     Height="7"
                                     Margin="0,0,7,0"
                                     VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                                                         Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="语音提醒" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>

                    <Button x:Name="AddTaskButton"
                            Style="{StaticResource PrimaryButton}"
                            Margin="12,0,0,0"
                            Click="AddTaskButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+"
                                       FontSize="16"
                                       FontWeight="Normal"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="新建任务" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Summary -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="26,18,26,0">
            <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="全部任务" Style="{StaticResource MutedText}" />
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <TextBlock Text="{Binding TotalCount}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text=" 项"
                                   Margin="1,0,0,4"
                                   VerticalAlignment="Bottom"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="未完成" Style="{StaticResource MutedText}" />
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <TextBlock Text="{Binding ActiveCount}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource WarningBrush}" />
                        <TextBlock Text=" 项"
                                   Margin="1,0,0,4"
                                   VerticalAlignment="Bottom"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="已完成" Style="{StaticResource MutedText}" />
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <TextBlock Text="{Binding CompletedCount}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text=" 项"
                                   Margin="1,0,0,4"
                                   VerticalAlignment="Bottom"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock Text="完成进度" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding ProgressPercentText}"
                                   DockPanel.Dock="Right"
                                   HorizontalAlignment="Right"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" />
                    </DockPanel>
                    <ProgressBar Grid.Row="1"
                                 Style="{StaticResource SlimProgressBar}"
                                 Maximum="100"
                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                 Margin="0,13,0,0" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,7,0,0">
                        <TextBlock Text="已完成 " FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding CompletedCountText}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- List header -->
        <Grid Grid.Row="2" Margin="28,22,28,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="任务清单" Style="{StaticResource SectionTitleText}" />
                <Border Margin="10,0,0,0"
                        Padding="7,2"
                        CornerRadius="7"
                        Background="{StaticResource AccentSoftBrush}">
                    <TextBlock Text="{Binding TotalCountText}"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" />
                </Border>
            </StackPanel>
            <TextBlock HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Text="按开始时间排序"
                       Style="{StaticResource MutedText}" />
        </Grid>

        <!-- Task list -->
        <Grid Grid.Row="3" Margin="28,0,28,0">
            <ListBox x:Name="TaskList"
                     ItemsSource="{Binding Tasks}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type client:TaskItem}">
                        <Border Style="{StaticResource TaskCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="4"
                                        Margin="0,15,0,15"
                                        CornerRadius="2"
                                        HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource PendingBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static client:TaskStatus.InProgress}">
                                                    <Setter Property="Background" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static client:TaskStatus.Completed}">
                                                    <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static client:TaskStatus.Cancelled}">
                                                    <Setter Property="Background" Value="{StaticResource BorderStrongBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,15,0,15" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding StartTimeText}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding EndTimeText, StringFormat='至 {0}'}"
                                               Margin="0,2,0,0"
                                               FontSize="10.5"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                    <Border Margin="0,7,0,0"
                                            Padding="6,2"
                                            HorizontalAlignment="Left"
                                            CornerRadius="5"
                                            Background="{StaticResource SurfaceAltBrush}">
                                        <TextBlock Text="{Binding DurationText}"
                                                   FontSize="9.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="8,15,12,15" VerticalAlignment="Top">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Title}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Top">
                                            <Border Padding="6,2"
                                                    CornerRadius="5"
                                                    Background="{StaticResource AccentSoftBrush}"
                                                    Visibility="{Binding IsRecurring, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="每天"
                                                           FontSize="9.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}" />
                                            </Border>
                                            <Border Margin="4,0,0,0"
                                                    Padding="6,2"
                                                    CornerRadius="5"
                                                    Background="{StaticResource DangerSoftBrush}"
                                                    Visibility="{Binding IsOverdue, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="已超时"
                                                           FontSize="9.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource DangerBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding Notes}"
                                               Margin="0,5,0,0"
                                               MaxHeight="18"
                                               FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>

                                <Grid Grid.Column="3" Margin="8,13,18,13" MinWidth="210">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Border Style="{StaticResource StatusPill}">
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusPillText}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,10,0,0">
                                        <Button Content="开始"
                                                Style="{StaticResource CardActionButton}"
                                                Visibility="{Binding CanStart, Converter={StaticResource BoolToVisibility}}"
                                                Click="StartTask_Click" />
                                        <Button Content="完成"
                                                Style="{StaticResource CardActionButton}"
                                                Visibility="{Binding CanComplete, Converter={StaticResource BoolToVisibility}}"
                                                Click="CompleteTask_Click" />
                                        <Button Content="恢复"
                                                Style="{StaticResource CardGhostButton}"
                                                Visibility="{Binding CanRestore, Converter={StaticResource BoolToVisibility}}"
                                                Click="RestoreTask_Click" />
                                        <Button Content="编辑"
                                                Style="{StaticResource CardGhostButton}"
                                                Click="EditTask_Click" />
                                        <Button Content="删除"
                                                Style="{StaticResource CardDangerButton}"
                                                Click="DeleteTask_Click" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Background="Transparent">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,0,0,42">
                    <Border Width="76"
                            Height="76"
                            CornerRadius="22"
                            Background="{StaticResource AccentSoftBrush}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="+"
                                   FontSize="34"
                                   FontWeight="Light"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,-3,0,0" />
                    </Border>
                    <TextBlock Text="这一天还没有任务"
                               Margin="0,16,0,0"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="从一件小事开始，把时间留给重要的事。"
                               Margin="0,6,0,0"
                               FontSize="11.5"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" />
                    <Button Content="新建第一个任务"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,18,0,0"
                            HorizontalAlignment="Center"
                            Click="AddTaskButton_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="4"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="28,9">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="VoiceStatusDot"
                             Width="6"
                             Height="6"
                             Fill="{StaticResource TextMutedBrush}" />
                    <TextBlock x:Name="SpeechStatusText"
                               Text="正在检测语音引擎…"
                               Margin="7,0,0,0"
                               FontSize="10.5"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="数据仅保存在本机"
                               FontSize="10.5"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                    <Button Content="打开数据目录"
                            Style="{StaticResource GhostButton}"
                            Padding="8,4"
                            FontSize="10.5"
                            Margin="10,0,0,0"
                            Click="OpenDataFolder_Click" />
                    <TextBlock Text="v1.1"
                               Margin="8,0,0,0"
                               FontSize="10.5"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toast -->
        <Border x:Name="Toast"
                Grid.RowSpan="5"
                Style="{StaticResource ToastBorder}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="24,0,24,54"
                MaxWidth="720"
                Panel.ZIndex="20"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <Border Width="22"
                        Height="22"
                        CornerRadius="6"
                        Background="#22FFFFFF"
                        VerticalAlignment="Top">
                    <TextBlock Text="&#xEA8F;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="11"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="ToastText"
                           Margin="10,0,0,0"
                           Foreground="White"
                           FontSize="12.5"
                           LineHeight="19"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

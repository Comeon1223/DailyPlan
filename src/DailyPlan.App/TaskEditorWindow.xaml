<Window x:Class="DailyPlan.App.TaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建任务"
        Width="580"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border Padding="28,24,28,24">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentSoftBrush}">
                    <TextBlock Text="✎"
                               FontSize="18"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="DialogTitle"
                               Text="新建任务"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock x:Name="DialogSubtitle"
                               Text="给这段时间一个明确的安排。"
                               Margin="0,3,0,0"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="任务名称" Style="{StaticResource FormLabelText}" Margin="0,22,0,6" />
            <TextBox x:Name="TitleBox"
                     Style="{StaticResource InputTextBox}"
                     Height="42"
                     MaxLength="100"
                     FontSize="14" />

            <TextBlock Text="备注（可选）" Style="{StaticResource FormLabelText}" Margin="0,16,0,6" />
            <TextBox x:Name="NotesBox"
                     Style="{StaticResource InputTextBox}"
                     Height="82"
                     MaxLength="2000"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     FontSize="12.5" />

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="StartDateLabel"
                               Text="开始时间"
                               Style="{StaticResource FormLabelText}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="88" />
                        </Grid.ColumnDefinitions>
                        <DatePicker x:Name="StartDatePicker"
                                    Grid.Column="0"
                                    Height="42"
                                    FontSize="13"
                                    Background="White"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    SelectedDateFormat="Short"
                                    VerticalContentAlignment="Center" />
                        <TextBox x:Name="StartTimeBox"
                                 Grid.Column="2"
                                 Style="{StaticResource InputTextBox}"
                                 Height="42"
                                 MaxLength="5"
                                 TextAlignment="Center"
                                 TextChanged="RepeatTimeBox_TextChanged"
                                 ToolTip="24 小时制，例如 09:30" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="EndDateLabel"
                               Text="结束时间"
                               Style="{StaticResource FormLabelText}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="88" />
                        </Grid.ColumnDefinitions>
                        <DatePicker x:Name="EndDatePicker"
                                    Grid.Column="0"
                                    Height="42"
                                    FontSize="13"
                                    Background="White"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    SelectedDateFormat="Short"
                                    VerticalContentAlignment="Center" />
                        <TextBox x:Name="EndTimeBox"
                                 Grid.Column="2"
                                 Style="{StaticResource InputTextBox}"
                                 Height="42"
                                 MaxLength="5"
                                 TextAlignment="Center"
                                 TextChanged="RepeatTimeBox_TextChanged"
                                 ToolTip="24 小时制，例如 10:30" />
                    </Grid>
                </StackPanel>
            </Grid>

            <Border Margin="0,16,0,0"
                    Padding="13,11"
                    CornerRadius="10"
                    Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <CheckBox x:Name="RepeatDailyCheck"
                              Content="每天重复这个时间段"
                              FontSize="12.5"
                              FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Checked="RepeatDailyCheck_Changed"
                              Unchecked="RepeatDailyCheck_Changed" />
                    <TextBlock Margin="22,4,0,0"
                               Text="从首次日期开始每天出现，并在每天的开始、结束时间提醒；每天单独记录完成状态。"
                               FontSize="10.5"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="任务状态" Style="{StaticResource FormLabelText}" />
                    <ComboBox x:Name="StatusCombo"
                              Style="{StaticResource InputComboBox}"
                              Width="180" />
                </StackPanel>
                <TextBlock x:Name="StatusHintText"
                           Grid.Column="1"
                           Margin="14,25,0,0"
                           VerticalAlignment="Center"
                           Text="结束时间需晚于开始时间，也可以跨天。"
                           Style="{StaticResource MutedText}"
                           TextWrapping="Wrap" />
            </Grid>

            <Border x:Name="ValidationBorder"
                    Visibility="Collapsed"
                    Margin="0,14,0,0"
                    Padding="11,8"
                    CornerRadius="8"
                    Background="{StaticResource DangerSoftBrush}">
                <TextBlock x:Name="ValidationText"
                           FontSize="11.5"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <Border Margin="0,22,0,0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消"
                        Style="{StaticResource SecondaryButton}"
                        Width="88"
                        IsCancel="True" />
                <Button x:Name="SaveButton"
                        Content="保存任务"
                        Style="{StaticResource PrimaryButton}"
                        Width="112"
                        Margin="10,0,0,0"
                        IsDefault="True"
                        Click="SaveButton_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
